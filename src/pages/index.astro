---
import Layout from '../layouts/Layout.astro';
import Journey from '../webgl/Journey';
import '../styles/journey.css';
import {
	AI_TAGS,
	AWARD,
	COMPANY,
	MARQUEE_TEXT,
	CONTACT_LINKS,
	EDUCATION,
	EXPERIENCE,
	PROJECTS,
	SECTIONS,
	SKILLS,
	STATS,
} from '../data/journey';

const navSections = SECTIONS.filter((s) => s.navLabel);
---

<Layout
	title="Shivrajsinh Zala — Frontend Developer"
	description="Portfolio of Shivrajsinh Zala — Frontend Developer specializing in WordPress, Squarespace, Webflow, Shopify, and Digital Marketing. Based in Rajkot, Gujarat."
>
	<Fragment slot="head">
		<meta name="google-site-verification" content="r_ohihwtpmUNEaxpkMTGONtJlv6Pk8p7J2eEX6NTm9A" />
		<meta name="author" content="Shivrajsinh Zala" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://portfolio.shivrajsinh.in/" />
		<meta property="og:title" content="Shivrajsinh Zala — Frontend Developer" />
		<meta
			property="og:description"
			content="WordPress • Squarespace • Webflow • Shopify • Digital Marketing — Frontend Developer with 30+ websites. Based in Rajkot, Gujarat."
		/>
		<meta property="og:image" content="https://portfolio.shivrajsinh.in/assets/images/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="en_IN" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Shivrajsinh Zala — Frontend Developer" />
		<meta
			name="twitter:description"
			content="WordPress • Squarespace • Webflow • Shopify • Digital Marketing — Frontend Developer with 30+ websites. Based in Rajkot, Gujarat."
		/>
		<meta name="twitter:image" content="https://portfolio.shivrajsinh.in/assets/images/og-image.png" />

		{/*
		  Person schema. The v1 homepage carried this and the WebGL rewrite
		  dropped it; worksFor.url is what ties the employer entity to their
		  actual site rather than leaving it a bare name string.
		*/}
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			'@id': 'https://portfolio.shivrajsinh.in/#person',
			name: 'Shivrajsinh Zala',
			jobTitle: 'Frontend Developer',
			url: 'https://portfolio.shivrajsinh.in/',
			email: 'hello@shivrajsinh.in',
			description:
				'Frontend Developer specializing in WordPress, Squarespace, Webflow, Shopify, and Digital Marketing. 30+ websites built and maintained. Based in Rajkot, Gujarat, India.',
			sameAs: [
				'https://github.com/shivrajsinhzala',
				'https://www.linkedin.com/in/shivrajsinh-zala/',
				'https://www.instagram.com/shivrajsinh.sh',
				'https://t.me/ShivrajsinhZala',
			],
			worksFor: {
				'@type': 'Organization',
				name: COMPANY.name,
				url: COMPANY.url,
			},
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Rajkot',
				addressRegion: 'Gujarat',
				addressCountry: 'IN',
			},
		})} />
	</Fragment>

	{/*
	  Entry moment. Replaces v1's preloader: holds for a beat while the first
	  frame renders and the tower assembles, then lifts. Skippable, and only
	  shown once per session.
	*/}
	<div class="journey-intro" id="journey-intro">
		<div class="journey-intro-inner">
			<div class="journey-intro-mark">SZ://DEV</div>
			<div class="journey-intro-bar"><span></span></div>
			<button type="button" class="journey-intro-skip" id="journey-intro-skip">SKIP</button>
		</div>
	</div>

	{/* Sound is off until asked for — it never starts on its own. */}
	<button
		type="button"
		class="journey-audio"
		id="journey-audio"
		aria-pressed="false"
		aria-label="Enable ambient sound"
	>
		<span class="journey-audio-bars" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="journey-audio-label">SOUND OFF</span>
	</button>

	{/* The 3D world. Purely decorative — every word lives in the DOM below. */}
	<Journey client:load transition:persist />

	{/*
	  Progress rail. The site navbar already carries the section links, so this
	  is a position indicator rather than a second copy of the menu — dots only,
	  with the label revealed on hover.
	*/}
	<nav class="journey-rail" aria-label="Journey progress">
		{
			navSections.map((s) => (
				<a href={`#${s.id}`} data-journey-nav={s.id} aria-label={s.navLabel}>
					<span class="journey-rail-dot" aria-hidden="true" />
					<span class="journey-rail-label">{s.navLabel}</span>
				</a>
			))
		}
	</nav>

	<main id="main-content" class="journey-scroll">
		{/* ---------------------------------------------------------- HERO */}
		<section id="hero" class="journey-panel" data-panel aria-labelledby="hero-title">
			<div class="journey-inner">
				<div class="max-w-3xl">
					<div class="reveal">
						<span class="j-label bg-brutal-pink">FRONTEND DEVELOPER • WORDPRESS & SQUARESPACE</span>
					</div>
					<h1 id="hero-title" class="j-heading j-heading--onvoid reveal mt-6">
						SHIVRAJSINH<br />
						<span class="text-brutal-cyan">ZALA</span>
					</h1>
					<div class="j-card reveal mt-8 max-w-xl">
						<p class="text-lg md:text-xl font-medium leading-tight mb-3">
							Frontend Developer at <a
								href={COMPANY.url}
								target="_blank"
								rel="noopener"
								class="bg-brutal-yellow px-1 underline decoration-2 underline-offset-2">{COMPANY.name}</a>.
							Based in <span class="bg-brutal-cyan px-1">Rajkot, Gujarat, India</span>.
						</p>
						<p class="font-mono text-sm text-gray-600 border-l-4 border-black pl-4">
							30+ websites built and maintained. I make WordPress behave and Squarespace look custom.
						</p>
					</div>
					<div class="reveal mt-8 flex flex-wrap gap-4">
						<a
							href="#contact"
							data-journey-nav="contact"
							class="brutal-border bg-brutal-black text-white px-6 py-3 brutal-shadow font-bold hover:bg-brutal-pink transition-colors"
						>
							LET'S TALK →
						</a>
						<a
							href="/resume"
							class="brutal-border bg-white text-black px-6 py-3 brutal-shadow font-bold hover:bg-brutal-cyan transition-colors"
						>
							VIEW RESUME
						</a>
					</div>
				</div>
			</div>
		</section>

		{/* AI banner marquee, carried over from v1. */}
		<div class="journey-marquee" aria-hidden="true">
			<div class="journey-marquee-track">
				<span>{MARQUEE_TEXT}</span><span>{MARQUEE_TEXT}</span>
			</div>
		</div>

		{/* --------------------------------------------------------- ABOUT */}
		<section id="about" class="journey-panel journey-panel--tall" data-panel aria-labelledby="about-title">
			<div class="journey-inner">
				<div class="reveal"><span class="j-label bg-brutal-pink">HOW I WORK</span></div>
				<h2 id="about-title" class="j-heading j-heading--onvoid reveal mt-4">
					AI MAKES ME<br /><span class="text-brutal-cyan">2X FASTER</span>
				</h2>
				<div class="j-card reveal mt-8 max-w-2xl">
					<p class="text-base md:text-xl font-mono">
						I write the code. AI handles the <span class="bg-brutal-gray px-1">repetitive stuff</span>.
						Result? You get <span class="bg-brutal-yellow px-1">better work, faster</span>. That's the edge.
					</p>
				</div>
				<div class="reveal mt-6 flex flex-wrap gap-3 font-mono text-xs md:text-sm">
					{
						AI_TAGS.map((tag) => (
							<span
								class:list={[
									'border-2 px-4 py-2',
									tag === 'HUMAN BRAIN FIRST'
										? 'border-brutal-pink text-brutal-pink'
										: 'border-white text-white',
								]}
							>
								{tag}
							</span>
						))
					}
				</div>
				<div class="reveal mt-10 grid grid-cols-2 md:grid-cols-4 gap-3">
					{
						STATS.map((stat) => (
							<div class="j-card text-center" style={`box-shadow: 8px 8px 0 0 ${stat.accent}`}>
								<div class="text-3xl md:text-5xl font-bold mb-1">{stat.value}</div>
								<div class="font-mono text-[10px] md:text-xs">{stat.label}</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* ---------------------------------------------------- EXPERIENCE */}
		<section
			id="experience"
			class="journey-panel journey-panel--tall"
			data-panel
			aria-labelledby="exp-title"
		>
			<div class="journey-inner">
				<div class="reveal"><span class="j-label">SECTION 02</span></div>
				<h2 id="exp-title" class="j-heading j-heading--onvoid reveal mt-4">WHERE I<br />WORK</h2>
				<div class="reveal mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
					<div class="j-card">
						<div class="j-label mb-3">PRESENT</div>
						<h3 class="text-2xl md:text-3xl font-bold mb-1">{EXPERIENCE.role}</h3>
						<div class="text-lg md:text-xl font-bold mb-2">
							<a
								href={EXPERIENCE.companyUrl}
								target="_blank"
								rel="noopener"
								class="underline decoration-2 underline-offset-2 hover:bg-brutal-yellow">{EXPERIENCE.company}</a>
						</div>
						<p class="font-mono text-sm mb-4 text-gray-700">{EXPERIENCE.location}</p>
						<div class="brutal-border bg-brutal-yellow p-3 font-mono text-xs inline-block">
							{EXPERIENCE.period}
						</div>
					</div>
					<div class="j-card j-card--dark">
						<h3 class="text-xl font-bold mb-4 font-mono">cat what-i-do.txt</h3>
						<ul class="space-y-3 font-mono text-sm">
							{
								EXPERIENCE.tasks.map((task) => (
									<li class="flex items-start gap-2">
										<span class="text-brutal-pink font-bold">→</span>
										<span>{task}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>

		{/* ------------------------------------------------------ PROJECTS */}
		<section
			id="projects"
			class="journey-panel journey-panel--corridor"
			aria-labelledby="projects-title"
		>
			<div class="journey-inner w-full">
				<div class="pt-32 pb-16" data-panel data-corridor-heading>
					<div class="reveal"><span class="j-label">SECTION 04</span></div>
					<h2 id="projects-title" class="j-heading j-heading--onvoid reveal mt-4">
						SELECTED<br />WORKS
					</h2>
				</div>

				{
					PROJECTS.map((p, i) => (
						<div
							class="corridor-step"
							data-panel
							data-project-index={i}
							data-side={i % 2 === 0 ? 'right' : 'left'}
						>
							<article class="corridor-caption">
								<div class="corridor-num" style={`color:${p.accent}`}>
									{p.num}
								</div>
								<div class="font-mono text-[10px] md:text-xs text-gray-500 mb-1">{p.stack}</div>
								<h3 class="text-xl md:text-2xl font-bold leading-tight mb-3">{p.title}</h3>
								{p.href ? (
									<a
										href={p.href}
										target="_blank"
										rel="noopener noreferrer"
										class="font-mono text-xs brutal-border px-3 py-2 inline-block font-bold hover:bg-black hover:text-white transition-colors"
										style={`background-color:${p.accent}`}
									>
										{p.cta} →
									</a>
								) : (
									<span
										class="font-mono text-xs brutal-border px-3 py-2 inline-block font-bold opacity-80"
										style={`background-color:${p.accent}`}
									>
										{p.cta}
									</span>
								)}
								{/* Image kept in the DOM for indexing and as the no-WebGL fallback. */}
								<img
									src={p.image}
									alt={p.alt}
									width="1024"
									height="682"
									loading="lazy"
									class="sr-only"
								/>
							</article>
						</div>
					))
				}

				<div class="corridor-step" data-panel data-project-index={PROJECTS.length} data-side="left">
					<div class="corridor-caption j-card--dark" style="background:#0a0a0a;color:#fff">
						<h3 class="text-2xl md:text-3xl font-bold mb-3">WANT MORE?</h3>
						<p class="font-mono text-xs md:text-sm mb-5">
							I have 30+ sites under my belt. Send me a message and I'll share the real portfolio.
						</p>
						<a
							href="#contact"
							data-journey-nav="contact"
							class="inline-block brutal-border bg-brutal-yellow text-black px-6 py-3 font-bold font-mono text-sm hover:bg-white transition-colors"
						>
							GET IN TOUCH →
						</a>
					</div>
				</div>
			</div>
		</section>

		{/* -------------------------------------------------------- SKILLS */}
		<section id="skills" class="journey-panel journey-panel--tall" data-panel aria-labelledby="skills-title">
			<div class="journey-inner">
				<div class="reveal"><span class="j-label">SECTION 03</span></div>
				<h2 id="skills-title" class="j-heading j-heading--onvoid reveal mt-4">MY<br />STACK</h2>
				<p class="reveal font-mono text-xs md:text-sm text-white/70 mt-4 max-w-md">
					WordPress first. Then everything else. I know what I'm good at.
				</p>
				<div class="reveal mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					{
						SKILLS.map((skill) => (
							<div class="j-card" style={`box-shadow: 8px 8px 0 0 ${skill.accent}`}>
								<div class="flex justify-between items-start mb-3">
									<span class="font-mono text-xs brutal-border px-2 py-1" style={`background-color:${skill.accent}`}>
										{skill.num}
									</span>
								</div>
								<h3 class="text-2xl font-bold mb-2">{skill.name}</h3>
								<p class="font-mono text-xs mb-4 text-gray-700">{skill.blurb}</p>
								<div class="w-full bg-brutal-gray brutal-border h-3 overflow-hidden">
									<div class="h-full" style={`width:${skill.level}%;background-color:${skill.accent}`} />
								</div>
								<div class="font-mono text-[10px] mt-2">{skill.note}</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* -------------------------------------------------------- AWARDS */}
		<section id="awards" class="journey-panel" data-panel aria-labelledby="awards-title">
			<div class="journey-inner">
				<div class="reveal"><span class="j-label bg-brutal-yellow text-black">ACHIEVEMENTS</span></div>
				<h2 id="awards-title" class="j-heading j-heading--onvoid reveal mt-4">
					{AWARD.heading}<br /><span class="text-brutal-cyan">{AWARD.highlight}</span>
				</h2>
				<div class="j-card j-card--dark reveal mt-8 max-w-2xl">
					<p class="text-lg md:text-xl font-mono mb-6 leading-relaxed">
						{AWARD.bodyBefore}<a
							href={COMPANY.url}
							target="_blank"
							rel="noopener"
							class="underline decoration-2 underline-offset-2 hover:text-brutal-cyan">{COMPANY.name}</a>{AWARD.bodyAfter}
					</p>
					<p class="text-sm md:text-base font-mono text-gray-400 border-l-2 border-brutal-cyan pl-4">
						{AWARD.quote}
					</p>
				</div>
			</div>
		</section>

		{/* ----------------------------------------------------- EDUCATION */}
		<section id="education" class="journey-panel" data-panel aria-labelledby="edu-title">
			<div class="journey-inner">
				<div class="reveal"><span class="j-label">SECTION 05</span></div>
				<h2 id="edu-title" class="j-heading j-heading--onvoid reveal mt-4">WHERE I<br />STUDIED</h2>
				<div class="reveal mt-8 space-y-6">
					{
						EDUCATION.map((edu) => (
							<div class="j-card flex flex-col md:flex-row gap-6 items-start md:items-center">
								<div
									class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center font-mono text-xl font-bold brutal-border flex-shrink-0"
									style={`background-color:${edu.accent}`}
								>
									{edu.badge}
								</div>
								<div class="flex-1">
									<h3 class="text-2xl md:text-3xl font-bold mb-1">{edu.degree}</h3>
									<p class="font-mono text-sm text-gray-600">{edu.school}</p>
									<p class="font-mono text-xs text-gray-400 mt-1">{edu.board}</p>
								</div>
								<div class="font-mono text-xs bg-brutal-yellow brutal-border px-4 py-3 font-bold">
									{edu.years}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* ------------------------------------------------------ TERMINAL */}
		<section id="terminal" class="journey-panel" data-panel aria-labelledby="terminal-title">
			<div class="journey-inner">
				<div class="reveal"><span class="j-label" style="background:#00ff88;color:#0a0a0a">SECTION 06</span></div>
				<h2 id="terminal-title" class="j-heading j-heading--onvoid reveal mt-4">
					TRY THE<br /><span style="color:#00ff88">TERMINAL</span>
				</h2>
				<p class="reveal font-mono text-sm md:text-base text-white/70 mt-4 max-w-sm">
					Who reads portfolios? Real developers explore them via CLI.
				</p>
				<p class="reveal font-mono text-xs text-white/50 mt-3 max-w-sm">
					Type <span style="color:#00ff88">about</span>, <span class="text-brutal-cyan">projects</span>,
					<span class="text-brutal-pink">skills</span> — or find the
					<span class="text-brutal-yellow">secrets</span>.
				</p>
				<div class="reveal mt-8">
					<button
						id="terminal-cta-btn"
						class="nav-terminal-btn brutal-border px-8 py-4 font-mono font-bold text-base tracking-wider hover:bg-white transition-all flex items-center gap-3"
						style="background:#00ff88;color:#0a0a0a"
						aria-label="Launch interactive terminal"
					>
						LAUNCH _TERMINAL
					</button>
				</div>
			</div>
		</section>

		{/* ------------------------------------------------------- CONTACT */}
		<section id="contact" class="journey-panel journey-panel--tall" data-panel aria-labelledby="contact-title">
			<div class="journey-inner max-w-3xl">
				<h2 id="contact-title" class="j-heading j-heading--onvoid reveal text-center">
					LET'S MAKE<br />SOMETHING
				</h2>
				<div class="j-card reveal mt-8">
					<p class="text-lg md:text-xl font-mono mb-8 text-center">
						Have a WordPress site that needs saving?<br />
						<span class="bg-brutal-pink text-white px-1">I'm your guy.</span>
					</p>
					<div class="space-y-3 font-mono">
						{
							CONTACT_LINKS.map((link) =>
								link.href ? (
									<a
										href={link.href}
										target={link.href.startsWith('http') ? '_blank' : undefined}
										rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										class="flex items-center justify-between brutal-border bg-white p-4 md:p-5 hover:bg-brutal-gray transition-colors"
									>
										<div class="flex items-center gap-4">
											<div
												class="w-10 h-10 flex items-center justify-center brutal-border flex-shrink-0"
												style={`background-color:${link.accent}`}
											/>
											<div>
												<p class="text-[10px] uppercase tracking-widest opacity-65 mb-1">{link.label}</p>
												<p class="text-sm md:text-base font-bold">{link.value}</p>
											</div>
										</div>
										<span class="text-[10px] md:text-xs brutal-border px-3 py-1.5 bg-brutal-black text-white font-bold tracking-wider">
											{link.cta}
										</span>
									</a>
								) : (
									<div class="flex items-center justify-between brutal-border bg-brutal-black text-white p-4 md:p-5">
										<div class="flex items-center gap-4">
											<div
												class="w-10 h-10 flex items-center justify-center border-2 flex-shrink-0"
												style={`border-color:${link.accent}`}
											/>
											<div>
												<p class="text-[10px] uppercase tracking-widest opacity-50 mb-1">{link.label}</p>
												<p class="text-sm md:text-base font-bold">{link.value}</p>
											</div>
										</div>
										<span
											class="text-[10px] md:text-xs border px-3 py-1.5 font-bold tracking-wider"
											style={`border-color:${link.accent};color:${link.accent}`}
										>
											{link.cta}
										</span>
									</div>
								)
							)
						}
					</div>
				</div>
			</div>
		</section>

		{/* --------------------------------------------------------- OUTRO */}
		{/*
		  The return tunnel's scroll runway. Carries no content — it exists so
		  the camera has distance to accelerate through the gates before the
		  journey loops back to the top.
		*/}
		<section id="outro" class="journey-panel journey-panel--outro" aria-hidden="true">
			<div class="journey-inner text-center">
				<p class="journey-outro-hint font-mono text-xs">KEEP SCROLLING</p>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { initJourney } from '../webgl/scrollController';
	import { audioPreference, setAudioEnabled } from '../webgl/audio';

	const start = () => {
		initJourney();

		// GlobalScripts only animates the navbar in on subpages — on the old
		// homepage the preloader timeline did it, and that preloader is gone.
		// Without this the site nav stays parked off-screen forever.
		//
		// Navbar.astro hides it with the Tailwind class `translate-y-[-100%]`,
		// which compiles to the CSS `translate` property in v4. `transform`
		// composes with `translate` rather than replacing it, so the reset has
		// to target `translate` itself.
		const navbar = document.getElementById('navbar');
		if (navbar) {
			navbar.style.transition = 'translate 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
			requestAnimationFrame(() => {
				navbar.style.translate = '0 0';
			});
		}

		setupIntro();
		setupAudioToggle();
	};

	/**
	 * Entry moment. Deliberately short and always dismissible: a splash that
	 * holds a visitor hostage is worse than no splash. Shown once per session.
	 */
	function setupIntro() {
		const intro = document.getElementById('journey-intro');
		if (!intro) return;

		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let seen = false;
		try {
			seen = sessionStorage.getItem('sz-journey-intro') === '1';
		} catch {
			/* private mode — just show it */
		}

		const dismiss = () => {
			intro.classList.add('is-done');
			document.documentElement.classList.remove('journey-intro-open');
			try {
				sessionStorage.setItem('sz-journey-intro', '1');
			} catch {
				/* ignore */
			}
		};

		if (seen || reduced) {
			dismiss();
			return;
		}

		document.documentElement.classList.add('journey-intro-open');
		requestAnimationFrame(() => intro.classList.add('is-loading'));

		const skip = document.getElementById('journey-intro-skip');
		skip?.addEventListener('click', dismiss);
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') dismiss();
		});

		window.setTimeout(dismiss, 1600);
	}

	/** Sound is opt-in; the AudioContext is only built inside the click. */
	function setupAudioToggle() {
		const btn = document.getElementById('journey-audio');
		if (!btn) return;

		const label = btn.querySelector('.journey-audio-label');
		let on = false;

		const paint = () => {
			btn.setAttribute('aria-pressed', on ? 'true' : 'false');
			btn.setAttribute('aria-label', on ? 'Disable ambient sound' : 'Enable ambient sound');
			if (label) label.textContent = on ? 'SOUND ON' : 'SOUND OFF';
		};

		btn.addEventListener('click', async () => {
			on = !on;
			paint();
			await setAudioEnabled(on);
		});

		// A previous "on" choice is remembered, but it still cannot start the
		// context without a gesture — so the button is armed, not auto-played.
		if (audioPreference()) {
			const arm = async () => {
				on = true;
				paint();
				await setAudioEnabled(true);
				window.removeEventListener('pointerdown', arm);
				window.removeEventListener('keydown', arm);
			};
			window.addEventListener('pointerdown', arm, { once: true });
			window.addEventListener('keydown', arm, { once: true });
		}

		paint();
	}

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		start();
	} else {
		document.addEventListener('DOMContentLoaded', start);
	}
</script>
